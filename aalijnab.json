    {
      "id": 543390,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eدیشب سنگین ترین حملات امریکا به ایران پس از آتش بس و امضا تفاهمنامه بود!\u003cbr/\u003e\u003cbr/\u003eشهرهایی که رسانه های رسمی از اصابت موشک به آنها خبر داده اند:\u003cbr/\u003e\u003cbr/\u003eبهبهان\u003cbr/\u003eدزفول\u003cbr/\u003eشادگان\u003cbr/\u003eآبادان\u003cbr/\u003eامیدیه\u003cbr/\u003eاهواز\u003cbr/\u003eاندیمشک\u003cbr/\u003eماهشهر\u003cbr/\u003eقشم\u003cbr/\u003eجاسک\u003cbr/\u003eسیریک\u003cbr/\u003eبندرعباس\u003cbr/\u003eچابهار\u003cbr/\u003eخنداب\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
