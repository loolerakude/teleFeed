    {
      "id": 8015,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e عبدالفتاح السیسی، رئیس‌جمهور مصر، در دیدار با جان رتکلیف، رئیس سازمان اطلاعات مرکزی آمریکا (سیا)، خواستار دستیابی به توافقی جامع برای پایان دادن به بحران مرتبط با جمهوری اسلامی، بازگرداندن ثبات به منطقه و تضمین آزادی کشتی‌رانی بین‌المللی شد.\u003cbr/\u003e\u003cbr/\u003eالسیسی در حضور حسن رشاد رئیس سازمان اطلاعات عمومی مصر، بر حمایت قاهره از امنیت و حاکمیت کشورهای عربی و مخالفت با حمله به این کشورها تأکید کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B5%D8%B1\"\u003e#مصر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
